# Copier en `.env` — ce fichier ne contient aucun secret réel.

# --- Discord ---
# Jeton du bot (https://discord.com/developers/applications). Laisser vide pour n'utiliser que le simulateur.
DISCORD_TOKEN=
# ID du serveur de test, pour un enregistrement immédiat des slash commands.
DISCORD_GUILD_ID=

# --- Stockage ---
# memory:// (volatile) ou sqlite:///chemin/vers/base.sqlite3
STORAGE_URL=sqlite:///botsuite.sqlite3

# --- Fournisseur LLM ---
# mock  -> réponses déterministes, aucune clé requise (défaut)
# openai-compatible -> toute API exposant /chat/completions
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_CONTEXT_BUDGET_TOKENS=2048
LLM_MAX_CONCURRENCY=2
LLM_QUOTA_CALLS=5
LLM_QUOTA_WINDOW_SECONDS=60

# --- Modération ---
SECURITY_JOIN_WINDOW_SECONDS=30
SECURITY_JOIN_THRESHOLD=8
SECURITY_LOCKDOWN_RISK=0.6
